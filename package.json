{
  "name": "@marsbos/mador",
  "version": "1.0.1",
  "description": "Make Any DOM Reactive",
  "author": {
    "name": "Marcel Bos"
  },
  "type": "module",
  "main": "./dist/mador.js",
  "module": "./dist/mador.js",
  "exports": {
    ".": {
      "import": "./dist/mador.js"
    }
  },
  "files": [
    "dist",
    "src/mador.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "reactive-dom",
    "reactivity",
    "dom",
    "vanilla-js",
    "vanilla-javascript",
    "progressive-enhancement",
    "ssr",
    "mpa"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "node build.mjs",
    "watch": "terser src/mador.js -o dist/mador.min.js --compress --mangle --watch",
    "format": "prettier --write \"src/**/*.{js,ts,html}\"  \"examples/**/*.{js,ts,html}\"",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "terser": "^5.48.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.10"
  }
}